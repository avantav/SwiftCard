NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Google Maps browser key. Enable Maps JavaScript API and Places API (New),
# attach billing, and restrict the key to the app's HTTPS origins with HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Legacy key names remain supported during Supabase's key transition.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# One-time development bootstrap. Remove the password after the user is created.
# SWIFTWALLET_BOOTSTRAP_SUPERADMIN_EMAIL=
# SWIFTWALLET_BOOTSTRAP_SUPERADMIN_NAME=
# SWIFTWALLET_BOOTSTRAP_SUPERADMIN_PASSWORD=

# Apple Wallet: keep private keys/certificates server-only.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
# Base64-encoded PEM values. Raw PEM with escaped newlines is also accepted.
APPLE_SIGNER_CERTIFICATE_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_WWDR_CERTIFICATE_BASE64=
APPLE_CERTIFICATE_PASSWORD=
# Stable 32-byte random secret encoded as Base64. Never rotate it without a
# compatibility rollout because installed passes derive their auth token from it.
APPLE_WALLET_UPDATE_SECRET_BASE64=
# Optional Bearer secret for the protected retry endpoint. The immediate update
# path does not require a cron; configure this when adding an external scheduler.
APPLE_WALLET_RETRY_SECRET=
# Canonical HTTPS origin used by public registration links and Wallet passes.
# Use only the origin (for example https://wallet.example.com), without a path.
SWIFTWALLET_PUBLIC_URL=
# Optional HTTPS demo destination; when empty the landing opens WhatsApp.
NEXT_PUBLIC_DEMO_REQUEST_URL=
# Optional WhatsApp override for demo requests (digits with country code).
NEXT_PUBLIC_SALES_WHATSAPP_NUMBER=
# Exact comma-separated additional hosts allowed for remote pass images.
# The NEXT_PUBLIC_SUPABASE_URL host is automatically allowed, including the
# public wallet-assets bucket, so the same-project bucket needs no extra value.
APPLE_WALLET_ASSET_HOSTS=

# Google Wallet: enable the API and add this service account as a Developer in
# Google Pay & Wallet Console. Keep the JSON server-only and outside Git.
GOOGLE_WALLET_ISSUER_ID=
# Raw single-line JSON (escaped PEM newlines) or the complete JSON encoded as Base64.
GOOGLE_WALLET_SERVICE_ACCOUNT=

# Optional stable 32-byte Base64 key for public camera QR encryption (server only).
# Without it, a domain-separated key is derived from the current server Supabase key.
# Keep the chosen key stable for printed/installed QR codes; rotate via a planned rollout.
CARD_SCAN_SECRET_BASE64=

# Stripe (self-service signup for Inicial/Crecimiento). Server-only; use test
# keys (sk_test_...) until launch. Run `npm run stripe:sync-catalog` to create
# products, prices and the IVA tax rate, then set STRIPE_IVA_TAX_RATE_ID.
STRIPE_SECRET_KEY=
# Signing secret of the endpoint ${SWIFTWALLET_PUBLIC_URL}/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# IVA handling: "automatic" uses Stripe Tax (requires the head office address
# and a Mexico registration in Stripe → Tax); "fixed" (default) applies
# STRIPE_IVA_TAX_RATE_ID.
STRIPE_TAX_MODE=
# Fixed IVA 16% exclusive tax rate printed by the catalog sync (txr_...).
STRIPE_IVA_TAX_RATE_ID=
